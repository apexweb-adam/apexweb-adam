# Apex Trading Platform - Environment Configuration
# Copy to .env and fill in your API keys

# === SAFETY (DO NOT CHANGE until verified profitable) ===
PAPER_TRADING_ONLY=true
INITIAL_BALANCE=100000

# === Database ===
DATABASE_URL=sqlite+aiosqlite:///./data/trading.db

# === Market Symbols ===
CRYPTO_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,DOGEUSDT,PEPEUSDT
STOCK_SYMBOLS=AAPL,MSFT,NVDA,TSLA,SPY,QQQ
FUTURES_SYMBOLS=ES=F,NQ=F
COMMODITY_SYMBOLS=GC=F,SI=F,CL=F,EURUSD=X

# === Intelligence APIs (optional but recommended) ===
NEWSAPI_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
TWITTER_BEARER_TOKEN=

# === Integrations ===
TRADINGVIEW_WEBHOOK_SECRET=
POLYMARKET_API_URL=https://gamma-api.polymarket.com

# === Strategy Defaults ===
MIN_WIN_RATE_TARGET=0.55
MAX_POSITION_PCT=0.05
STOP_LOSS_PCT=0.02
TAKE_PROFIT_PCT=0.04

# === Dashboard ===
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
