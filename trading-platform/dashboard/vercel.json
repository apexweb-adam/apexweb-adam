{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  },
  "rewrites": [
    {
      "source": "/api/active-gate",
      "destination": "/api/backend/active-gate"
    }
  ],
  "env": {
    "BACKEND_URL": "https://apex-trading-backend.onrender.com",
    "BACKEND_WS_URL": "wss://apex-trading-backend.onrender.com",
    "PLATFORM_BUNDLE_REVISION": "2026-08-28-r21"
  }
}
